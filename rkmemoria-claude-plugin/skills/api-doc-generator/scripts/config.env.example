# ADELIE API Documentation Verification Script - Configuration
# Copy this file to .env and update values before running

# Backend server base URL (change when BE is running)
BASE_URL=http://localhost:8080

# Authentication - provide either AUTH_TOKEN or credentials for auto-login
AUTH_TOKEN=
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# Login endpoint path (used for auto-login when AUTH_TOKEN is empty)
LOGIN_ENDPOINT=/login

# Request timeout in seconds
TIMEOUT=30

# SSL verification (set to true for HTTPS with valid certs)
VERIFY_SSL=false

# Documentation files directory (relative to project root or absolute)
DOCS_DIR=../documents

# Report output directory
REPORT_OUTPUT_DIR=./reports

# Dry-run mode: parse docs only, skip HTTP calls (true/false)
DRY_RUN=true

# Execute write operations (POST/PUT/DELETE that modify data)
# Set to true only in test environments!
EXECUTE_WRITES=false

# Verbose output
VERBOSE=false
